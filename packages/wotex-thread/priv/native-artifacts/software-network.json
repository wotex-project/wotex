      {"name": "openthread", "url": "https://codeload.github.com/openthread/openthread/tar.gz/f34c5e5476829d9205e80b37fccc2bdfe97e1dab", "revision": "f34c5e5476829d9205e80b37fccc2bdfe97e1dab", "sha256": "93109098957ac2bfa6e37d69d1c094f653b5e73cc33c7e5a498e6e1d45ade452"}
    ]
