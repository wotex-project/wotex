#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
workspace=$(dirname "$root")
work=$(mktemp -d "${TMPDIR:-/tmp}/wotex-binding-http-archive.XXXXXX")
archive="$work/wotex_binding_http-0.1.0.tar"
source_dir="$work/source"

cleanup() {
  case "$work" in
    "${TMPDIR:-/tmp}"/wotex-binding-http-archive.*) rm -rf -- "$work" ;;
    *) echo "refusing unsafe archive-check cleanup" >&2; exit 1 ;;
  esac
}

trap cleanup EXIT HUP INT TERM

for dependency in wotex wotex-runtime; do
  if [ ! -f "$workspace/$dependency/mix.exs" ]; then
    echo "missing adjacent $dependency checkout" >&2
    exit 1
  fi
done

cd "$root"
env -u WOTEX_PATH_DEPS MIX_ENV=dev mix hex.build --output "$archive"
env -u WOTEX_PATH_DEPS MIX_ENV=dev mix hex.build --unpack --output "$source_dir"

metadata=$(tar -xOf "$archive" metadata.config)

printf '%s\n' "$metadata" | grep -Fq '{<<"version">>,<<"0.1.0">>}'
printf '%s\n' "$metadata" | grep -Fq '{<<"name">>,<<"wotex">>}'
printf '%s\n' "$metadata" | grep -Fq '{<<"name">>,<<"wotex_runtime">>}'

release_requirements=$(printf '%s\n' "$metadata" | grep -Fc '{<<"requirement">>,<<"~> 0.1.0">>}')

if [ "$release_requirements" -lt 2 ]; then
  echo "archive metadata does not pin both Wotex release requirements" >&2
  exit 1
fi

if printf '%s\n' "$metadata" |
    grep -Eq '<<"repository">>,<<"(git|path)"|<<"path">>|WOTEX_PATH_DEPS'; then
  echo "archive metadata contains a mutable dependency source" >&2
  exit 1
fi

if tar -tf "$archive" | grep -Eq '(^|/)(\.claude|AGENTS\.md|CLAUDE\.md|test|deps|_build|\.git)(/|$)'; then
  echo "archive contains development or agent machinery" >&2
  exit 1
fi

ln -s "$workspace/wotex" "$work/wotex"
ln -s "$workspace/wotex-runtime" "$work/wotex-runtime"

cd "$source_dir"
WOTEX_PATH_DEPS=1 MIX_ENV=test mix deps.get
WOTEX_PATH_DEPS=1 MIX_ENV=test mix compile --warnings-as-errors

WOTEX_PATH_DEPS=1 MIX_ENV=test mix run --no-start -e '
Application.load(:wotex_binding_http)
callback = Application.spec(:wotex_binding_http, :mod)

unless callback in [nil, [], :undefined] do
  raise "archive defines an application callback"
end

IO.puts("archive application callback: none")
'

if command -v sha256sum >/dev/null 2>&1; then
  digest=$(sha256sum "$archive" | cut -d ' ' -f 1)
else
  digest=$(shasum -a 256 "$archive" | cut -d ' ' -f 1)
fi

echo "archive source compiled cleanly: $digest"
