{
  "@context": "https://www.w3.org/2022/wot/td/v1.1",
  "id": "urn:wotex:lab:http:room",
  "title": "HTTP room",
  "base": "http://127.0.0.1:0/",
  "security": ["nosec_sc"],
  "securityDefinitions": {
    "nosec_sc": {"scheme": "nosec"},
    "bearer_sc": {"scheme": "bearer"}
  },
  "properties": {
    "temperature": {
      "type": "number",
      "unit": "Cel",
      "observable": true,
      "forms": [
        {"href": "properties/temperature", "contentType": "application/json", "op": "readproperty"},
        {
          "href": "properties/temperature/observe",
          "contentType": "application/json",
          "subprotocol": "sse",
          "op": ["observeproperty", "unobserveproperty"]
        }
      ]
    },
    "target": {
      "type": "number",
      "unit": "Cel",
      "forms": [
        {
          "href": "properties/target",
          "contentType": "application/json",
          "op": "writeproperty",
          "security": ["bearer_sc"]
        }
      ]
    },
    "large": {
      "type": "string",
      "forms": [{"href": "properties/large", "contentType": "application/json", "op": "readproperty"}]
    },
    "slow": {
      "type": "number",
      "forms": [{"href": "properties/slow", "contentType": "application/json", "op": "readproperty"}]
    },
    "redirect": {
      "type": "number",
      "forms": [{"href": "properties/redirect", "contentType": "application/json", "op": "readproperty"}]
    },
    "html": {
      "type": "number",
      "forms": [{"href": "properties/html", "contentType": "application/json", "op": "readproperty"}]
    }
  },
  "actions": {
    "setTarget": {
      "input": {"type": "number", "unit": "Cel", "minimum": 5, "maximum": 35},
      "forms": [{"href": "actions/set-target", "contentType": "application/json", "op": "invokeaction"}]
    }
  }
}
