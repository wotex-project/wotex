{
  "name": "@wotex/lab-workbench-assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "node bin/clean_assets.mjs && vite build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet",
    "check:browser:documentation": "node bin/check_documentation_browser.mjs",
    "check:browser:islands": "node bin/check_islands_browser.mjs",
    "check": "pnpm run typecheck && pnpm run test:layout && pnpm run build && node bin/check_assets.mjs",
    "test:layout": "node --experimental-strip-types --test assets/layout-profile.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/svelte-vite": "10.6.0",
    "@types/node": "26.6.3",
    "playwright": "1.63.0",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
