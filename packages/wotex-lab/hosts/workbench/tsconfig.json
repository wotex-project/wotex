{
  "compilerOptions": {
    "lib": ["DOM", "ES2024"],
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node", "vite/client"]
  },
  "include": [".storybook/**/*.ts", "assets/**/*.ts", "vite.config.ts"]
}
