{
  "compilerOptions": {
    "paths": {
      "$lib/*": ["./assets/*"],
      "$seeds/*": ["./priv/seeds/*"]
    },
    "lib": ["DOM", "ES2024"],
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "target": "ES2024",
    "types": ["node", "vite/client"]
  },
  "include": [
    ".storybook/**/*.ts",
    "assets/**/*.ts",
    "assets/**/*.svelte",
    "test/frontend/**/*.ts",
    "vite.config.ts",
    "tools/**/*.ts"
  ]
}
