#!/bin/sh
set -eu

lab_package_work=$(mktemp -d "$(pwd)/.archive-check.XXXXXX")
env -u WOTEX_PATH_DEPS MIX_ENV=dev mix hex.build --unpack --output "$lab_package_work/source"

ruby -rjson -rpathname - "$lab_package_work/source" <<'RUBY'
root = Pathname.new(ARGV.fetch(0)).realpath
required = %w[lib/wotex/lab.ex mix.exs README.md LICENSE NOTICE
              docs/specs/catalogue.yaml docs/plans/wotex-lab-completion.md
              docs/provenance/source-index.json priv/fixtures/thermal/thing-description.json]
required.each { |path| abort "archive missing #{path}" unless root.join(path).file? }
files = Dir.glob(root.join('**/*').to_s, File::FNM_DOTMATCH).select { |f| File.file?(f) }
files.each do |file|
  path = Pathname.new(file).relative_path_from(root).to_s
  abort "excluded archive content: #{path}" if path.match?(%r{\A(?:docs/tasks|deps|_build|test|bin|\.git)(?:/|\z)})
  abort "symlink in archive: #{path}" if File.symlink?(file)
end
puts "package contents: #{files.size} files; no independent-consumer claim"
RUBY

env -u WOTEX_PATH_DEPS MIX_ENV=prod mix run --no-compile --no-deps-check --no-start -e '
deps = Mix.Project.config()[:deps]
Enum.each(deps, fn dep ->
  opts = dep |> Tuple.to_list() |> List.last()
  if is_list(opts) and Enum.any?([:path, :git, :github], &Keyword.has_key?(opts, &1)) do
    raise "production dependency is not an artifact requirement"
  end
end)
IO.puts("package metadata: production requirements use Hex")
'

# Retain the inspected candidate in the ignored temporary directory for review.
echo "inspected candidate retained at $lab_package_work/source"
