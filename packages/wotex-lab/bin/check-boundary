#!/bin/sh
set -eu

if rg -n '(Application\.(put_env|put_all_env|start|ensure_all_started)\(|String\.to_atom\(|:erlang\.binary_to_atom\(|use Application|apps_path:|git:|github:)' lib mix.exs; then
  echo "implicit activation, mutable global policy or source dependency detected" >&2
  exit 1
fi

if rg -n --hidden -g '!.git' -g '!.git/**' -g '!deps/**' -g '!_build/**' -g '!doc/**' -g '!cover/**' -g '!.archive-check.*/**' '([/]Users[/]|[/]home[/])' .; then
  echo "machine-local path in publishable source" >&2
  exit 1
fi

echo "boundary: explicit composition and consumer-neutral source"
