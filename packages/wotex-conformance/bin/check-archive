#!/bin/sh
set -eu

version=$(mix run --no-compile --no-start -e 'IO.write(Mix.Project.config()[:version])')
archive="wotex_conformance-${version}.tar"

if [ ! -f "$archive" ]
then
  echo "expected current wotex_conformance archive: $archive" >&2
  exit 1
fi
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT HUP INT TERM

tar -xf "$archive" -C "$temporary"
for outer in VERSION CHECKSUM metadata.config contents.tar.gz
do
  test -f "$temporary/$outer" || { echo "archive is missing $outer" >&2; exit 1; }
done

mkdir "$temporary/package"
tar -xzf "$temporary/contents.tar.gz" -C "$temporary/package"
for packaged in mix.exs LICENSE NOTICE README.md CHANGELOG.md lib priv docs
do
  test -e "$temporary/package/$packaged" || {
    echo "package contents are missing $packaged" >&2
    exit 1
  }
done

if find "$temporary/package" -type d \( -name .git -o -name deps -o -name _build \) | rg -q .
then
  echo "archive contains development state" >&2
  exit 1
fi

if [ -e "$temporary/package/priv/plts" ]
then
  echo "archive contains local Dialyzer state" >&2
  exit 1
fi

bin/check-boundary "$temporary/package"

dependency_root=_build/test/lib
test -d "$dependency_root/jason/ebin" || {
  echo "compiled jason dependency is missing; run the test compile first" >&2
  exit 1
}

mkdir "$temporary/ebin"
find "$temporary/package/lib" -type f -name '*.ex' -print | sort | \
  xargs elixirc --warnings-as-errors -pa "$dependency_root/jason/ebin" -o "$temporary/ebin"

test -f "$temporary/ebin/Elixir.Wotex.Conformance.beam" || {
  echo "out-of-tree archive compilation did not produce Wotex.Conformance" >&2
  exit 1
}

if command -v sha256sum >/dev/null 2>&1
then
  digest=$(sha256sum "$archive" | awk '{print $1}')
else
  digest=$(shasum -a 256 "$archive" | awk '{print $1}')
fi

echo "archive contents passed"
echo "out-of-tree archive compilation passed"
echo "archive sha256: $digest"
