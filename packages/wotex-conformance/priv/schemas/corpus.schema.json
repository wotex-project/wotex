{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wotex.io/schemas/conformance/corpus-1.0.json",
  "title": "Wotex Conformance Corpus Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "vectors", "digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1, "maxLength": 255},
    "revision": {"type": "string", "minLength": 1, "maxLength": 64},
    "vectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "digest"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 255},
          "file": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*\\.json$"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
