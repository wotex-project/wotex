{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wotex.io/schemas/conformance/observation-1.0.json",
  "title": "Wotex Conformance Normalized Observation 1.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "document"],
      "properties": {
        "accepted": {"const": true},
        "document": {"type": "object"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "errors"],
      "properties": {
        "accepted": {"const": false},
        "errors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "phase", "path"],
            "properties": {
              "code": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$"},
              "phase": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$"},
              "path": {"type": "string", "maxLength": 256, "pattern": "^/"}
            }
          }
        }
      }
    }
  ]
}
