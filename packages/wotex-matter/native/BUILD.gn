import("//build_overrides/chip.gni")
import("${chip_root}/build/chip/tools.gni")
import("${chip_root}/src/app/chip_data_model.gni")

foreach(host,
        [
          "wotex-matter-host",
          "wotex-matter-flow-host",
          "wotex-matter-resource-host",
        ]) {
  executable(host) {
    cflags_cc = [ "-std=c++17" ]
    sources = [
      "src/authority.cpp",
      "src/bridge_storage.cpp",
      "src/commissioning.cpp",
      "src/controller.cpp",
      "src/interaction.cpp",
      "src/logging.cpp",
      "src/protocol.cpp",
      "src/sdk_storage.cpp",
      "src/storage.cpp",
      "src/subscription.cpp",
      "src/value.cpp",
    ]
    if (host == "wotex-matter-flow-host") {
      defines = [ "WOTEX_MATTER_FLOW_TESTING=1", "WOTEX_MATTER_RESOURCE_TESTING=1" ]
      sources += [ "testing/process_flow_host.cpp", "testing/resource_testing.cpp" ]
    } else if (host == "wotex-matter-resource-host") {
      defines = [ "WOTEX_MATTER_RESOURCE_TESTING=1" ]
      sources += [ "testing/resource_host.cpp", "testing/resource_testing.cpp" ]
    } else {
      sources += [ "src/host.cpp" ]
    }
    include_dirs = [
      "include",
      "third_party",
    ]
    deps = [
      "${chip_root}/src/app/data-model-provider:data-model-provider",
      "${chip_root}/src/controller:controller",
      "${chip_root}/src/controller/data_model:data_model",
      "${chip_root}/src/credentials:file_attestation_trust_store",
      "${chip_root}/src/lib",
      "${chip_root}/src/platform",
      "${chip_root}/src/protocols/interaction_model",
    ]
  }
}

# Executed by the explicit native build in both normal and sanitizer modes.
# This test uses the real SDK keystore and certificate store without starting
# the controller or server singleton or exposing test credentials in a host.
executable("wotex-matter-sdk-bridge-storage-test") {
  cflags_cc = [ "-std=c++17" ]
  sources = [
    "src/bridge_storage.cpp",
    "src/logging.cpp",
    "src/sdk_storage.cpp",
    "src/storage.cpp",
    "testing/sdk_bridge_storage_test.cpp",
  ]
  include_dirs = [ "include", "third_party" ]
  deps = [
    "${chip_root}/src/credentials",
    "${chip_root}/src/crypto",
    "${chip_root}/src/lib",
    "${chip_root}/src/platform",
  ]
}

# Separate generated server profile; never linked into the controller host.
if (chip_build_tools) {
  # Pure codec probe with the pinned SDK's metadata and TLV reader. It starts
  # no SDK server; allocation fault injection is isolated from server fixtures.
  executable("wotex-matter-bridge-codec-test") {
    cflags_cc = [ "-std=c++17" ]
    sources = [
      "src/bridge_input.cpp",
      "src/bridge_handoff.cpp",
      "src/bridge_handoff_owner.cpp",
      "src/bridge_request_frame.cpp",
      "src/logging.cpp",
      "testing/bridge_request_frame_test.cpp",
    ]
    include_dirs = [ "include", "third_party" ]
    deps = [ "${chip_root}/src/lib" ]
  }

  chip_data_model("bridge-model") {
    zap_file = "bridge-common/bridge-app.zap"
    idl = "bridge-common/bridge-app.matter"
    is_server = true
    cflags = [ "-DCHIP_DEVICE_CONFIG_DYNAMIC_ENDPOINT_COUNT=16" ]
  }

  executable("wotex-matter-sdk-bridge-server-test") {
    # SDK headers are external dependencies. In particular, ConcreteClusterPath
    # intentionally leaves its unused expansion flag uninitialized. Keep all
    # first-party diagnostics enabled without analysing that SDK-only padding.
    cflags = [
      "-DCHIP_DEVICE_CONFIG_DYNAMIC_ENDPOINT_COUNT=16",
      "-isystem" + rebase_path("${chip_root}/src", root_build_dir),
    ]
    cflags_cc = [ "-std=c++17" ]
    defines = [ "WOTEX_MATTER_BRIDGE_TESTING=1" ]
    sources = [
      "src/bridge_credentials.cpp",
      "src/bridge_endpoint_model.cpp",
      "src/bridge_endpoints.cpp",
      "src/bridge_guard.cpp",
      "src/bridge_handoff.cpp",
      "src/bridge_handoff_owner.cpp",
      "src/bridge_input.cpp",
      "src/bridge_output.cpp",
      "src/bridge_replies.cpp",
      "src/bridge_request_frame.cpp",
      "src/bridge_requests.cpp",
      "src/bridge_resources.cpp",
      "src/bridge_server.cpp",
      "src/bridge_storage.cpp",
      "src/bridge_writes.cpp",
      "src/logging.cpp",
      "src/sdk_storage.cpp",
      "src/storage.cpp",
      "testing/sdk_bridge_endpoints_test.cpp",
      "testing/sdk_bridge_credentials_test.cpp",
      "testing/sdk_bridge_guard_test.cpp",
      "testing/sdk_bridge_replies_test.cpp",
      "testing/sdk_bridge_provider_test.cpp",
      "testing/sdk_bridge_requests_test.cpp",
      "testing/sdk_bridge_server_test.cpp",
      "testing/sdk_bridge_wait_test.cpp",
      "testing/sdk_bridge_writes_test.cpp",
    ]
    include_dirs = [ "include", "third_party" ]
    deps = [
      ":bridge-model",
      "${chip_root}/examples/platform/linux:linux-commissionable-data-provider",
      "${chip_root}/src/app/clusters/bridged-device-basic-information-server",
      "${chip_root}/src/app/server",
      "${chip_root}/src/credentials",
      "${chip_root}/src/lib",
      "${chip_root}/src/platform",
    ]
  }
}
