{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wotex.io/contracts/routines/basis/v1",
  "title": "Closed routine basis and observation values",
  "oneOf": [
    {
      "$ref": "#/definitions/basis"
    },
    {
      "$ref": "#/definitions/fact"
    },
    {
      "$ref": "#/definitions/unit"
    },
    {
      "$ref": "#/definitions/limits"
    },
    {
      "$ref": "#/definitions/registry"
    }
  ],
  "definitions": {
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "semantic_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "semantic_digest"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "properties": {
        "dimension": {
          "enum": [
            "temperature",
            "fraction",
            "illuminance",
            "power",
            "energy",
            "time",
            "electric_potential"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "scale_n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "scale_d": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "offset_n": {
          "type": "integer",
          "minimum": -9223372036854775807,
          "maximum": 9223372036854775807
        },
        "offset_d": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "min": {
          "type": "integer",
          "minimum": -9223372036854775807,
          "maximum": 9223372036854775807
        },
        "max": {
          "type": "integer",
          "minimum": -9223372036854775807,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "dimension",
        "name",
        "scale_n",
        "scale_d",
        "offset_n",
        "offset_d",
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "basis": {
      "type": "object",
      "properties": {
        "format": {
          "const": "wotex.routines.basis@1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "byte_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "semantic_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "implementation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "compiler_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "affordance": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "property",
                "action",
                "event"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "operation": {
              "enum": [
                "readproperty",
                "writeproperty",
                "observeproperty",
                "invokeaction",
                "subscribeevent"
              ]
            }
          },
          "required": [
            "type",
            "name",
            "operation"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "property"
                  }
                }
              },
              "then": {
                "properties": {
                  "operation": {
                    "enum": [
                      "readproperty",
                      "writeproperty",
                      "observeproperty"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "action"
                  }
                }
              },
              "then": {
                "properties": {
                  "operation": {
                    "enum": [
                      "invokeaction"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "event"
                  }
                }
              },
              "then": {
                "properties": {
                  "operation": {
                    "enum": [
                      "subscribeevent"
                    ]
                  }
                }
              }
            }
          ]
        },
        "value": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "boolean",
                "integer",
                "enum"
              ]
            },
            "unit": {
              "anyOf": [
                {
                  "$ref": "#/definitions/unit"
                },
                {
                  "type": "null"
                }
              ]
            },
            "enum": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "uniqueItems": true,
              "minItems": 0,
              "maxItems": 1024
            }
          },
          "required": [
            "type",
            "unit",
            "enum"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "boolean"
                  }
                }
              },
              "then": {
                "properties": {
                  "unit": {
                    "type": "null"
                  },
                  "enum": {
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "integer"
                  }
                }
              },
              "then": {
                "properties": {
                  "unit": {
                    "$ref": "#/definitions/unit"
                  },
                  "enum": {
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "enum"
                  }
                }
              },
              "then": {
                "properties": {
                  "unit": {
                    "type": "null"
                  },
                  "enum": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "security_contract": {
          "$ref": "#/definitions/reference"
        },
        "lifecycle_contract": {
          "$ref": "#/definitions/reference"
        },
        "required_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/reference"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 1024
        },
        "evidence": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "enum": [
                  "device_report",
                  "derived_report",
                  "protocol_response"
                ]
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 1024
            },
            "freshness_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "require_source_time": {
              "type": "boolean"
            },
            "continuity": {
              "enum": [
                "continuous",
                "snapshot"
              ]
            },
            "completion": {
              "enum": [
                "local_queue",
                "protocol_response",
                "correlated_report",
                "reported_match"
              ]
            }
          },
          "required": [
            "sources",
            "freshness_ms",
            "require_source_time",
            "continuity",
            "completion"
          ],
          "additionalProperties": false
        },
        "effects": {
          "type": "object",
          "properties": {
            "resource_roles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "uniqueItems": true,
              "minItems": 0,
              "maxItems": 1024
            },
            "repeat": {
              "enum": [
                "never",
                "after_known_failure",
                "after_reported_safe"
              ]
            },
            "stop": {
              "enum": [
                "unsupported",
                "separate_effect"
              ]
            },
            "supersession": {
              "const": "block_until_known"
            },
            "partial_possible": {
              "type": "boolean"
            },
            "unknown_possible": {
              "type": "boolean"
            }
          },
          "required": [
            "resource_roles",
            "repeat",
            "stop",
            "supersession",
            "partial_possible",
            "unknown_possible"
          ],
          "additionalProperties": false
        },
        "timing": {
          "type": "object",
          "properties": {
            "deadline_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "dwell_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "cooldown_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "uncertainty": {
              "const": "block"
            }
          },
          "required": [
            "deadline_ms",
            "duration_ms",
            "dwell_ms",
            "cooldown_ms",
            "uncertainty"
          ],
          "additionalProperties": false
        },
        "analysis": {
          "type": "object",
          "properties": {
            "classification": {
              "enum": [
                "supported",
                "unsupported"
              ]
            },
            "profile": {
              "anyOf": [
                {
                  "$ref": "#/definitions/reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "properties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "uniqueItems": true,
              "minItems": 0,
              "maxItems": 1024
            }
          },
          "required": [
            "classification",
            "profile",
            "properties"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "classification": {
                    "const": "supported"
                  }
                }
              },
              "then": {
                "properties": {
                  "profile": {
                    "$ref": "#/definitions/reference"
                  },
                  "properties": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "classification": {
                    "const": "unsupported"
                  }
                }
              },
              "then": {
                "properties": {
                  "profile": {
                    "type": "null"
                  },
                  "properties": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        },
        "annotations": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "uniqueItems": true,
              "minItems": 0,
              "maxItems": 1024
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "format",
        "id",
        "version",
        "byte_digest",
        "semantic_digest",
        "implementation_digest",
        "compiler_digest",
        "affordance",
        "value",
        "security_contract",
        "lifecycle_contract",
        "required_contracts",
        "evidence",
        "effects",
        "timing",
        "analysis",
        "annotations"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "thing_id": {
          "type": "string",
          "format": "uri"
        },
        "affordance_type": {
          "enum": [
            "property",
            "event"
          ]
        },
        "affordance_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "value": {},
        "unit": {
          "anyOf": [
            {
              "$ref": "#/definitions/unit"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "enum": [
            "usable",
            "stale",
            "invalid",
            "unknown"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "source_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "source_time": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "receipt_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "receipt_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "profile_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "replay": {
          "enum": [
            "fresh",
            "retained",
            "replayed"
          ]
        },
        "continuity": {
          "enum": [
            "continuous",
            "baseline",
            "lost"
          ]
        },
        "expires_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "derivation_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/contributor"
          },
          "uniqueItems": true,
          "minItems": 0,
          "maxItems": 1024
        }
      },
      "required": [
        "id",
        "thing_id",
        "affordance_type",
        "affordance_name",
        "value",
        "unit",
        "quality",
        "source_id",
        "source_epoch",
        "sequence",
        "source_time",
        "received_at",
        "receipt_epoch",
        "receipt_ms",
        "profile_digest",
        "replay",
        "continuity",
        "expires_ms",
        "derivation_digest",
        "contributors"
      ],
      "additionalProperties": false
    },
    "contributor": {
      "type": "object",
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "source_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "receipt_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "expires_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "fact_id",
        "source_id",
        "source_epoch",
        "sequence",
        "receipt_epoch",
        "expires_ms"
      ],
      "additionalProperties": false
    },
    "registry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "semantic_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "requires": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/reference"
            },
            "uniqueItems": true,
            "minItems": 0,
            "maxItems": 1024
          }
        },
        "required": [
          "id",
          "version",
          "semantic_digest",
          "requires"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 1024
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_string_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_collection_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_integer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "max_bytes",
        "max_depth",
        "max_nodes",
        "max_string_bytes",
        "max_collection_size",
        "max_integer"
      ],
      "additionalProperties": false
    }
  }
}
