#!/bin/sh
set -eu

set -- lib mix.exs

if [ -d test ]
then
  set -- "$@" test
fi

if rg -n '(Application\.start\(|use Ash|use Phoenix|[A-Z][A-Za-z0-9_.]*\.Repo|Ecto\.Repo|Oban\.)' "$@"
then
  echo "consumer-neutral runtime boundary violation" >&2
  exit 1
fi

if rg -n 'apps_path[[:space:]]*:' mix.exs
then
  echo "umbrella configuration is forbidden" >&2
  exit 1
fi

if rg -n --hidden -g '!.git/**' -g '!deps/**' -g '!_build/**' -g '!doc/**' -g '!cover/**' '([/]Users[/]|[/]home[/])' .
then
  echo "consumer filesystem path found" >&2
  exit 1
fi
