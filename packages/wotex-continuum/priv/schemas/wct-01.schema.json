{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wotex.io/schemas/continuum/wct-01/1.0.0",
  "title": "WCT.01 continuum values",
  "oneOf": [
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/compatibility"},
    {"$ref": "#/$defs/executionContext"},
    {"$ref": "#/$defs/capability"}
  ],
  "$defs": {
    "schemaVersion": {"const": "1.0.0"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 512},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "extensions": {
      "type": "object",
      "propertyNames": {"format": "uri"},
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "capabilityRequirement": {
      "type": "object",
      "required": ["id", "version_requirement"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version_requirement": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["kind", "schema_version", "schema_requirement", "required_capabilities", "extensions"],
      "properties": {
        "kind": {"const": "compatibility"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "schema_requirement": {"type": "string", "minLength": 1, "maxLength": 256},
        "required_capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capabilityRequirement"},
          "uniqueItems": true
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["kind", "schema_version", "id", "version", "operations", "modes", "network", "degradation", "extensions"],
      "properties": {
        "kind": {"const": "capability"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"},
        "operations": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["saas", "hybrid", "connected_onprem", "air_gapped"]}
        },
        "network": {"enum": ["none", "local", "external"]},
        "degradation": {"enum": ["fail_closed", "read_only", "queue", "unavailable"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "executionContext": {
      "type": "object",
      "required": ["kind", "schema_version", "execution_id", "node_id", "mode", "observed_at", "extensions"],
      "properties": {
        "kind": {"const": "execution_context"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "execution_id": {"$ref": "#/$defs/identifier"},
        "node_id": {"$ref": "#/$defs/identifier"},
        "mode": {"$ref": "wct-03.schema.json#/$defs/mode"},
        "observed_at": {"type": "string", "format": "date-time"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["kind", "schema_version", "manifest_id", "artifact", "compatibility", "supported_modes", "capabilities", "extensions"],
      "properties": {
        "kind": {"const": "continuum_manifest"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "manifest_id": {"$ref": "#/$defs/identifier"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["saas", "hybrid", "connected_onprem", "air_gapped"]}
        },
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capability"}
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    }
  }
}
