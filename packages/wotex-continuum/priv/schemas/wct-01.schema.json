{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wotex.io/schemas/continuum/wct-01/2.0.0",
  "title": "WCT.01 continuum values",
  "oneOf": [
    {"$ref": "#/$defs/manifestEnvelope"},
    {"$ref": "#/$defs/compatibilityEnvelope"},
    {"$ref": "#/$defs/executionScopeEnvelope"},
    {"$ref": "#/$defs/capabilityEnvelope"}
  ],
  "$defs": {
    "schemaVersion": {"const": "2.0.0"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 512},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\\.((0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "extensions": {
      "type": "object",
      "propertyNames": {"format": "uri"},
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "capabilityRequirement": {
      "type": "object",
      "required": ["id", "version_requirement"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version_requirement": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    },
    "compatibilityEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/compatibility"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "compatibility": {
      "type": "object",
      "required": ["schema_requirement"],
      "properties": {
        "kind": {"const": "compatibility"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "schema_requirement": {"type": "string", "minLength": 1, "maxLength": 256},
        "required_capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capabilityRequirement"},
          "uniqueItems": true
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "capabilityEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/capability"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "capability": {
      "type": "object",
      "required": ["id", "version", "operations", "modes", "network", "degradation"],
      "properties": {
        "kind": {"const": "capability"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"},
        "operations": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["saas", "hybrid", "connected_onprem", "air_gapped"]}
        },
        "network": {"enum": ["none", "local", "external"]},
        "degradation": {"enum": ["fail_closed", "read_only", "queue", "unavailable"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "executionScopeEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/executionScope"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "executionScope": {
      "type": "object",
      "required": ["execution_id", "node_id", "mode", "observed_at"],
      "properties": {
        "kind": {"const": "execution_scope"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "execution_id": {"$ref": "#/$defs/identifier"},
        "node_id": {"$ref": "#/$defs/identifier"},
        "mode": {"$ref": "https://wotex.io/schemas/continuum/wct-03/2.0.0#/$defs/mode"},
        "observed_at": {"type": "string", "format": "date-time"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "manifestEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/manifest"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "manifest": {
      "type": "object",
      "required": ["manifest_id", "artifact", "compatibility", "supported_modes", "capabilities"],
      "properties": {
        "kind": {"const": "continuum_manifest"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "manifest_id": {"$ref": "#/$defs/identifier"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["saas", "hybrid", "connected_onprem", "air_gapped"]}
        },
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capability"}
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    }
  }
}
