{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wotex.io/schemas/continuum/wct-03/2.0.0",
  "title": "WCT.03 continuum mode and lifecycle values",
  "oneOf": [
    {"$ref": "#/$defs/modeEnvelope"},
    {"$ref": "#/$defs/lifecycleEnvelope"},
    {"$ref": "#/$defs/degradationEnvelope"},
    {"$ref": "#/$defs/exitReceiptEnvelope"}
  ],
  "$defs": {
    "schemaVersion": {"const": "2.0.0"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 512},
    "extensions": {
      "type": "object",
      "propertyNames": {"format": "uri"},
      "additionalProperties": true
    },
    "modeEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/mode"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "mode": {
      "type": "object",
      "required": ["deployment", "connectivity"],
      "properties": {
        "kind": {"const": "mode"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "deployment": {"enum": ["saas", "hybrid", "connected_onprem", "air_gapped"]},
        "connectivity": {"enum": ["connected", "intermittent", "disconnected"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "allOf": [
        {
          "if": {"properties": {"deployment": {"const": "air_gapped"}}},
          "then": {"properties": {"connectivity": {"const": "disconnected"}}}
        }
      ],
      "additionalProperties": false
    },
    "lifecycleEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/lifecycle"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "lifecycle": {
      "type": "object",
      "required": ["subject_id", "state", "generation", "changed_at"],
      "properties": {
        "kind": {"const": "lifecycle"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "state": {"enum": ["staged", "ready", "active", "degraded", "draining", "stopped", "removed"]},
        "generation": {"type": "integer", "minimum": 0},
        "changed_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "degradationEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/degradation"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "degradation": {
      "type": "object",
      "required": ["degradation_id", "subject_id", "level", "capabilities", "reason_codes", "since", "recoverable"],
      "properties": {
        "kind": {"const": "degradation"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "degradation_id": {"$ref": "#/$defs/identifier"},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "level": {"enum": ["none", "reduced", "unavailable"]},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "since": {"type": "string", "format": "date-time"},
        "recoverable": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"$ref": "https://wotex.io/schemas/continuum/wct-02/2.0.0#/$defs/evidenceReference"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "allOf": [
        {
          "if": {"properties": {"level": {"const": "none"}}},
          "then": {
            "properties": {
              "capabilities": {"maxItems": 0},
              "reason_codes": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"level": {"enum": ["reduced", "unavailable"]}}},
          "then": {
            "properties": {
              "capabilities": {"minItems": 1},
              "reason_codes": {"minItems": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "exitReceiptEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/exitReceipt"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "exitReceipt": {
      "type": "object",
      "required": ["receipt_id", "subject_id", "operation", "status", "requested_at"],
      "properties": {
        "kind": {"const": "exit_receipt"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "receipt_id": {"$ref": "#/$defs/identifier"},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "operation": {"enum": ["export", "remove"]},
        "status": {"enum": ["requested", "running", "completed", "failed", "partial"]},
        "requested_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "artifacts": {"type": "array", "items": {"$ref": "https://wotex.io/schemas/continuum/wct-02/2.0.0#/$defs/evidenceReference"}},
        "residuals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "error": {"$ref": "https://wotex.io/schemas/continuum/wct-02/2.0.0#/$defs/failure"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["requested", "running"]}}},
          "then": {
            "properties": {
              "completed_at": false,
              "error": false,
              "residuals": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "completed"}}},
          "then": {
            "required": ["completed_at"],
            "properties": {"error": false}
          }
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {"required": ["completed_at", "error"]}
        },
        {
          "if": {"properties": {"status": {"const": "partial"}}},
          "then": {
            "required": ["completed_at", "residuals"],
            "properties": {"residuals": {"minItems": 1}, "error": false}
          }
        },
        {
          "if": {
            "properties": {
              "operation": {"const": "remove"},
              "status": {"const": "completed"}
            }
          },
          "then": {"properties": {"residuals": {"maxItems": 0}}}
        }
      ],
      "additionalProperties": false
    }
  }
}
