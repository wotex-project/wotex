{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wotex.io/schemas/continuum/wct-02/2.0.0",
  "title": "WCT.02 continuum exchange values",
  "oneOf": [
    {"$ref": "#/$defs/observationProposalEnvelope"},
    {"$ref": "#/$defs/actionIntentEnvelope"},
    {"$ref": "#/$defs/actionResultEnvelope"},
    {"$ref": "#/$defs/evidenceReferenceEnvelope"},
    {"$ref": "#/$defs/deliveryEnvelope"}
  ],
  "$defs": {
    "schemaVersion": {"const": "2.0.0"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 512},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "extensions": {
      "type": "object",
      "propertyNames": {"format": "uri"},
      "additionalProperties": true
    },
    "failure": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 256},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "details": true
      },
      "additionalProperties": false
    },
    "evidenceReferenceEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/evidenceReference"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "evidenceReference": {
      "type": "object",
      "required": ["evidence_id", "uri", "digest", "media_type", "captured_at"],
      "properties": {
        "kind": {"const": "evidence_reference"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "uri": {"type": "string", "format": "uri"},
        "digest": {"$ref": "#/$defs/digest"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 512},
        "captured_at": {"type": "string", "format": "date-time"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceReference"}
    },
    "observationProposalEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/observationProposal"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "observationProposal": {
      "type": "object",
      "required": ["proposal_id", "thing_id", "affordance_type", "affordance_name", "value", "observed_at", "context"],
      "properties": {
        "kind": {"const": "observation_proposal"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "proposal_id": {"$ref": "#/$defs/identifier"},
        "thing_id": {"type": "string", "format": "uri"},
        "affordance_type": {"enum": ["property", "event"]},
        "affordance_name": {"$ref": "#/$defs/identifier"},
        "value": true,
        "observed_at": {"type": "string", "format": "date-time"},
        "sequence": {"type": "integer", "minimum": 0},
        "quality": {"type": "object"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "context": {"$ref": "https://wotex.io/schemas/continuum/wct-01/2.0.0#/$defs/executionScope"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "actionIntentEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/actionIntent"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "actionIntent": {
      "type": "object",
      "required": ["intent_id", "thing_id", "action_name", "input", "requested_at", "idempotency_key", "context"],
      "properties": {
        "kind": {"const": "action_intent"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "intent_id": {"$ref": "#/$defs/identifier"},
        "thing_id": {"type": "string", "format": "uri"},
        "action_name": {"$ref": "#/$defs/identifier"},
        "input": true,
        "requested_at": {"type": "string", "format": "date-time"},
        "idempotency_key": {"$ref": "#/$defs/identifier"},
        "requested_by": {"$ref": "#/$defs/identifier"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "context": {"$ref": "https://wotex.io/schemas/continuum/wct-01/2.0.0#/$defs/executionScope"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "actionResultEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/actionResult"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "actionResult": {
      "type": "object",
      "required": ["result_id", "intent_id", "status", "context"],
      "properties": {
        "kind": {"const": "action_result"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "result_id": {"$ref": "#/$defs/identifier"},
        "intent_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["accepted", "running", "succeeded", "failed", "cancelled", "unknown"]},
        "output": true,
        "error": {"$ref": "#/$defs/failure"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "context": {"$ref": "https://wotex.io/schemas/continuum/wct-01/2.0.0#/$defs/executionScope"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "succeeded"}}},
          "then": {
            "required": ["output", "completed_at"],
            "properties": {"error": false}
          }
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {
            "required": ["error", "completed_at"],
            "properties": {"output": false}
          }
        },
        {
          "if": {"properties": {"status": {"const": "cancelled"}}},
          "then": {
            "required": ["completed_at"],
            "properties": {"output": false, "error": false}
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["accepted", "running", "unknown"]}}},
          "then": {
            "properties": {"output": false, "error": false, "completed_at": false}
          }
        }
      ],
      "additionalProperties": false
    },
    "deliveryEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/delivery"},
        {"required": ["kind", "schema_version"]}
      ]
    },
    "delivery": {
      "type": "object",
      "required": ["delivery_id", "item_kind", "item_id", "source", "destination", "status", "attempt", "emitted_at"],
      "properties": {
        "kind": {"const": "delivery"},
        "schema_version": {"$ref": "#/$defs/schemaVersion"},
        "delivery_id": {"$ref": "#/$defs/identifier"},
        "item_kind": {"enum": ["action_intent", "action_result", "capability", "compatibility", "continuum_manifest", "degradation", "delivery", "evidence_reference", "execution_scope", "exit_receipt", "lifecycle", "mode", "observation_proposal"]},
        "item_id": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/identifier"},
        "destination": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["pending", "in_flight", "delivered", "acknowledged", "failed", "unknown"]},
        "attempt": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "emitted_at": {"type": "string", "format": "date-time"},
        "acknowledged_at": {"type": "string", "format": "date-time"},
        "error": {"$ref": "#/$defs/failure"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "acknowledged"}}},
          "then": {
            "required": ["acknowledged_at"],
            "properties": {"error": false}
          }
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {
            "required": ["error"],
            "properties": {"acknowledged_at": false}
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["pending", "in_flight", "delivered", "unknown"]}}},
          "then": {
            "properties": {"acknowledged_at": false, "error": false}
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
