#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
work=$(mktemp -d "$root/.archive-check.XXXXXX")

cleanup() {
  case "$work" in
    "$root"/.archive-check.*) rm -rf -- "$work" ;;
    *) echo "refusing unsafe archive-check cleanup" >&2; exit 1 ;;
  esac
}

trap cleanup EXIT HUP INT TERM

cd "$root"
env -u WOTEX_PATH_DEPS MIX_ENV=dev mix hex.build --unpack --output "$work/source"
ln -s ../../wotex "$work/wotex"

cd "$work/source"
WOTEX_PATH_DEPS=1 MIX_ENV=test mix deps.get
WOTEX_PATH_DEPS=1 MIX_ENV=test mix compile --warnings-as-errors

WOTEX_PATH_DEPS=1 MIX_ENV=test mix run --no-start -e '
Application.load(:wotex_continuum)

unless Application.spec(:wotex_continuum, :mod) in [nil, [], :undefined] do
  raise "archive defines an application callback"
end

IO.puts("archive application callback: none")
'

